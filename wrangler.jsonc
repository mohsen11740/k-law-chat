{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k-law-chat",
  "account_id": "c6b60e72f8f995cfa6985884ea2782a7",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
